{
  "version": 1,
  "id": "notes-cli",
  "title": "파일에 메모를 저장하고 다시 조회하는 CLI 완성",
  "target": {
    "outcome": "사용자가 메모를 추가하고 프로세스를 재시작한 뒤에도 조회할 수 있으며 잘못된 입력은 명확하게 거절한다.",
    "users": [
      "로컬 터미널 사용자"
    ],
    "in_scope": [
      "메모 추가·목록 조회",
      "JSON 파일 영속화",
      "빈 입력과 손상된 파일의 오류 처리",
      "CLI 사용법"
    ],
    "out_of_scope": [
      "서버·로그인·동기화",
      "웹 UI",
      "배포 및 GitHub 게시"
    ],
    "requirements": [
      {
        "id": "R1",
        "description": "추가한 메모가 별도 프로세스에서도 같은 순서로 조회된다."
      },
      {
        "id": "R2",
        "description": "잘못된 입력과 손상된 파일을 명확한 오류로 처리하며 기존 데이터를 보존한다."
      }
    ],
    "acceptance": [
      {
        "id": "A1",
        "requirement_ids": [
          "R1"
        ],
        "scenario": "임시 저장 파일에 두 메모를 추가한 뒤 새 CLI 프로세스에서 같은 내용과 순서로 조회한다.",
        "check_ids": [
          "notes-persistence"
        ]
      },
      {
        "id": "A2",
        "requirement_ids": [
          "R2"
        ],
        "scenario": "공백 메모를 추가하면 비정상 종료 코드와 오류를 반환하고 저장 파일을 바꾸지 않는다.",
        "check_ids": [
          "notes-empty"
        ]
      },
      {
        "id": "A3",
        "requirement_ids": [
          "R2"
        ],
        "scenario": "손상된 JSON 파일을 읽으면 오류로 종료하며 해당 파일을 덮어쓰지 않는다.",
        "check_ids": [
          "notes-corrupt"
        ]
      }
    ]
  },
  "decisions": [
    {
      "area": "scope",
      "answer": "명시한 세 가지 인수 조건을 모두 만족한다.",
      "basis": "user",
      "rationale": "기존 코드의 완성도와 무관하게 동일 목표를 적용한다."
    },
    {
      "area": "architecture",
      "answer": "Python 3.10+ 표준 라이브러리 기반 CLI를 사용한다.",
      "basis": "user",
      "rationale": "별도 서비스와 패키지 설치 없이 로컬에서 사용한다."
    },
    {
      "area": "data",
      "answer": "사용자가 지정한 JSON 파일에 저장하고 원자적 교체로 저장한다.",
      "basis": "user",
      "rationale": "저장 실패와 손상 파일에서 기존 데이터 보존이 필요하다."
    },
    {
      "area": "interface",
      "answer": "python3 -m notes --store PATH add TEXT 및 list 명령을 제공한다.",
      "basis": "user",
      "rationale": "호출 규약과 명시적인 오류 종료 코드가 인수 테스트의 대상이다."
    },
    {
      "area": "dependencies",
      "answer": "Python과 로컬 파일 시스템만 사용한다. 외부 자격 증명은 필요하지 않다.",
      "basis": "user",
      "rationale": "외부 API나 데이터베이스는 범위 밖이다."
    },
    {
      "area": "security",
      "answer": "별도 네트워크 요청을 하지 않으며 입력 텍스트를 명령으로 실행하지 않는다.",
      "basis": "user",
      "rationale": "명시한 저장 파일만 읽고 쓴다."
    },
    {
      "area": "verification",
      "answer": "각 인수 테스트는 별도 CLI 프로세스를 실행하고 내용·종료 코드·파일 보존을 검사한다.",
      "basis": "user",
      "rationale": "실제 동작과 재시작 후 영속화까지 검증한다."
    },
    {
      "area": "operations",
      "answer": "macOS와 Linux에서 실행한다. 파일 권한 오류는 사용자에게 명확히 표시한다.",
      "basis": "user",
      "rationale": "이 예제에는 서버 운영 및 배포 과정이 없다."
    },
    {
      "area": "delivery",
      "answer": "검증된 작업 트리와 사용법을 제공한다.",
      "basis": "user",
      "rationale": "이 예제는 커밋·PR·배포를 수행하지 않는다."
    },
    {
      "area": "autonomy",
      "answer": "공개 CLI와 저장 형식을 유지하는 세부 구현·디버깅은 위임한다. 결정 범위 밖 장애는 근거와 재개 조건을 기록한다.",
      "basis": "user",
      "rationale": "실행 시작 후 사용자 추가 설명 없이 같은 목표를 달성한다."
    }
  ],
  "open_questions": [],
  "rules": [
    ".loop/rules/workflow.md",
    ".loop/rules/context.md",
    ".loop/rules/quality.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".loop/rules/delegation.md"
  ],
  "checks": [
    {
      "id": "notes-persistence",
      "kind": "acceptance",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "tests.test_notes_acceptance.NotesAcceptance.test_add_and_list_across_processes"
      ],
      "cwd": ".",
      "timeout_seconds": 60
    },
    {
      "id": "notes-empty",
      "kind": "acceptance",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "tests.test_notes_acceptance.NotesAcceptance.test_reject_empty_without_write"
      ],
      "cwd": ".",
      "timeout_seconds": 60
    },
    {
      "id": "notes-corrupt",
      "kind": "acceptance",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "tests.test_notes_acceptance.NotesAcceptance.test_preserve_corrupt_store"
      ],
      "cwd": ".",
      "timeout_seconds": 60
    }
  ],
  "milestones": [
    {
      "id": "M1",
      "title": "메모 추가·조회와 프로세스 간 영속화",
      "acceptance_ids": [
        "A1"
      ]
    },
    {
      "id": "M2",
      "title": "오류 처리·기존 데이터 보존과 사용법",
      "acceptance_ids": [
        "A2",
        "A3"
      ]
    }
  ],
  "execution": {
    "implementer": "codex",
    "max_gate_attempts": 3,
    "review_timeout_seconds": 600,
    "max_run_seconds": 14400,
    "orchestrator": "codex",
    "max_worker_calls": 40,
    "worker_timeout_seconds": 600
  }
}
